# Template only. npm run setup:env creates .env with a random local password.
POSTGRES_USER=platform
POSTGRES_PASSWORD=
POSTGRES_DB=platform_dev
POSTGRES_PORT=15432
DATABASE_URL=
# SQLx creates isolated temporary databases; use a dedicated local/CI admin connection.
TEST_DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
SERVER_BIND=127.0.0.1:8080
RUST_LOG=platform_server=info
API_PORT=8080
WEB_PORT=3000
# Local development serves plain HTTP; production must set this to true.
SESSION_COOKIE_SECURE=false
# Auth tuning (optional; defaults: m=19456 KiB, t=2, p=1, ttl=12h).
# ARGON2_M_COST=19456
# ARGON2_T_COST=2
# ARGON2_P_COST=1
# SESSION_TTL_HOURS=12
